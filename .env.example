# Per-server config. Copy the example for the app this server runs, to that
# app folder, as .env (chmod 600). Never commit a real .env or real values.
#
# This file only names the shared switches. Fill values in the app example:
#   apps/core/.env.example      — Bobby-first client app (app.codegreene.com today)
#   apps/billing/.env.example   — Planet Grid billing app (app.planet-grid.com today)
#
# Each server keeps its own data (database, uploads). The same code runs on
# both. Features are switched on per client. Billing is a module that must
# stay on only for Planet Grid.

# Which app this server should start: core | billing | both
# "both" is for a later merged deploy. Today each live server runs one.
APP_NAME=core

# Billing must stay off everywhere except Planet Grid.
ENABLE_BILLING=0
