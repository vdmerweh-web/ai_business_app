# Copy to .env next to docker-compose.yml (chmod 600). Never commit .env.
# This module is the live Planet Grid app (app.planet-grid.com). Switch it on
# only for Planet Grid. Do not change billing behaviour to match the test app.

# Database
DB_PASSWORD=

# Admin bootstrap (only used when the users table is empty)
ADMIN_PASSWORD_HASH_B64=
ADMIN_EMAIL=hannes@planet-grid.com

# Public URLs
APP_URL=https://app.planet-grid.com

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.planet-grid.com/auth/google/callback

# Bot link (Grid). Leave empty on a server that should not talk to the bot.
GRID_WEBHOOK_URL=
GRID_WEBHOOK_AUTH=
GRID_WEBHOOK_SECRET=
GRID_BOT_TOKEN=

# Mail (invoice emails). Leave SMTP_PASS empty until mail is configured.
SMTP_HOST=mail.planet-grid.com
SMTP_PORT=587
SMTP_USER=hannes@planet-grid.com
SMTP_PASS=
MAIL_FROM=Hannes - Planet Grid <hannes@planet-grid.com>

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hannes@planet-grid.com

# Set to 1 only on the Planet Grid server. Leave as 0 everywhere else.
ENABLE_BILLING=0

# Who counts as a site admin (comma-separated emails). Everyone else is a client
# and only sees Bobby, Web, CRM and Scott. Do not hard-code a domain; set this per server.
ADMIN_EMAILS=hannes@planet-grid.com
# Agents shown as chat entries in the admin view (comma-separated ids).
ADMIN_AGENTS=grid,bobby,scott
SERVER_NAME=app.planet-grid.com
MAIN_CLIENT_REF=

# Grok (xAI). Leave empty until a key is added. Never commit the real key.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_ZAR_PER_USD=17.50
SCOTT_WEBHOOK_URL=
