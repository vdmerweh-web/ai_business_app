# Copy to .env (chmod 600). Never commit .env.
APP_URL=https://app.codegreene.com
# Google OAuth web client (from box secrets APP_CODEGREENE_GOOGLE_CLIENT_ID / APP_CODEGREENE_GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on the Google client exactly. /api/auth/google/callback also works.
GOOGLE_REDIRECT_URI=https://app.codegreene.com/auth/google/callback
ALLOWED_EMAILS=hannes@codegreene.com,josh@codegreene.com,mark@codegreene.com
# Bot link (Admin). Webhook out to Admin's routine; bearer token for Admin's replies in.
CG_WEBHOOK_URL=
CG_WEBHOOK_AUTH=
CG_WEBHOOK_SECRET=
CG_BOT_TOKEN=
# Optional
EXTRA_ORIGINS=
INVENTORY_DIR=/var/lib/bot_admin
INVENTORY_GID=33
# Dev only: mock Google login. Refused unless APP_URL is http://localhost...
DEV_MOCK_LOGIN=0

# Grok (xAI). Leave empty until a key is added. Never commit the real key.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_ZAR_PER_USD=17.50

# Who counts as a site admin (comma-separated emails). Everyone else is a client
# and only sees Bobby, Web, CRM and Scott. Falls back to ALLOWED_EMAILS if empty.
ADMIN_EMAILS=hannes@codegreene.com,josh@codegreene.com,mark@codegreene.com
ADMIN_AGENTS=grid,admin,bobby,scott
SERVER_NAME=app.codegreene.com
GRID_WEBHOOK_URL=
SCOTT_WEBHOOK_URL=

# xAI Management API (prepaid Grok balance checks at 07:00 and 19:00 SAST).
# Leave XAI_MANAGEMENT_KEY empty until a management key is added on the server.
# Do not put the real management key in this file. The box's IP is not allowed;
# only the live servers should hold the key.
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=43eb7c23-1ec6-46f2-8596-5e8aa3b2ae5c

# --- Sites, builder, scheduler and bot webhooks (25 Nov 2026) ---
# Generate each secret on the server with: openssl rand -hex 32   (never commit or print them)
# Postgres admin password for the site databases (db container).
PG_ADMIN_PASSWORD=
# 64 hex characters. Encrypts each site copy's own database password.
SITE_SECRET_KEY=
# Shared secret between api and the builder container.
BUILDER_TOKEN=
# HMAC secrets for signed bot messages. IN = the bot signs messages it sends to the app.
# OUT = the app signs messages it sends to the bot. Give each bot its two secrets privately.
HOOK_SECRET_ADMIN_IN=
HOOK_SECRET_GRID_IN=
HOOK_SECRET_ADMIN_OUT=
HOOK_SECRET_GRID_OUT=
# Where to POST signed messages to Admin (defaults to CG_WEBHOOK_URL). Grid uses GRID_WEBHOOK_URL,
# or polls GET /api/hooks/grid/inbox if that is empty. Nothing is sent while an OUT secret is empty.
ADMIN_HOOK_URL=
# Hostnames whose sub-names map to client sites, like sunny-bakery.codegreene.com
SITE_BASE_DOMAINS=codegreene.com,planet-grid.com
# Scheduler: how many jobs may run at once (default 3).
SCHED_WORKERS=3
# Spread for jobs set on the hour, in seconds (default 7200 = up to 2 hours).
SCHED_JITTER_SEC=7200
